# Nunca versione o arquivo .env. Preencha com os dados recebidos pelo grupo.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:PORT/BANCO?sslmode=require
# Mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
PORT=3000

# Lista separada por vírgula com os endereços do frontend.
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# Certificado da autoridade do banco (Aiven: "CA certificate"), em uma linha, com \n no lugar das quebras.
DATABASE_CA_CERT=
# true só em desenvolvimento, sem DATABASE_CA_CERT. Nunca em produção.
DATABASE_SSL_INSECURE=true

# Chave em https://www.pexels.com/api/ para buscar fotos de tênis.
PEXELS_API_KEY=
